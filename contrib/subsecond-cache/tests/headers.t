#!/usr/bin/perl
use strict;
use warnings;
use Test::More;

# Each row drives ngx_http_cache_fine_headers() with a fixed clock: 100 s on
# the wall clock, 15 ms after the upstream request began.
#
# expected is "deadline update-window error-window status Age Age-Ms
# cacheable".  The deadline is relative to now, in milliseconds, and zero
# when the entry is not fine.  Age and Age-Ms are the fields that would be
# sent, or "-" when absent.
#
# env: FINE_AGE_HEADER=0 turns proxy_cache_fine_age_header off.
# FINE_STORED_AGE is the age in ms of a stored fine entry with a 200 ms
# lifetime.  COARSE_STORED_AGE is the age in seconds of a stored
# whole-second entry.

my $binary = $ENV{FINE_HEADERS_BINARY} // die "Set FINE_HEADERS_BINARY\n";
my $pair = 'max-age=0, max-age-ms=200';
my @cases = (
    { description => 'origin response delay',
      tags => ['2:positive', '9:positive'],
      mode => 1, cc => $pair, cc2 => '', age => '', age_ms => '',
      expected => '185 0 0 used 0 15 1' },
    { description => 'shield residence and RTT',
      tags => ['2:positive', '6:positive'],
      mode => 2, cc => $pair, cc2 => '', age => '0', age_ms => '175',
      expected => '10 0 0 used 0 190 1' },
    { description => 'seconds rollover',
      mode => 2, cc => 'max-age=1,max-age-ms=1250', cc2 => '', age => '1', age_ms => '1175',
      expected => '60 0 0 used 1 1190 1' },
    { description => 'split lines',
      mode => 1, cc => 'max-age-ms=200', cc2 => 'max-age=0', age => '', age_ms => '',
      expected => '185 0 0 used 0 15 1' },
    { description => 'zero lifetime',
      mode => 1, cc => 'max-age=0,max-age-ms=0', cc2 => '', age => '', age_ms => '',
      expected => '-15 0 0 used 0 15 1' },
    { description => 'unpaired',
      tags => ['9:negative'],
      mode => 1, cc => 'max-age-ms=200', cc2 => '', age => '', age_ms => '',
      expected => '0 0 0 fallback:companion - - 1' },
    { description => 'duplicate',
      mode => 1, cc => $pair, cc2 => 'max-age-ms=200', age => '', age_ms => '',
      expected => '0 0 0 fallback:companion - - 1' },
    { description => 'negative',
      mode => 1, cc => 'max-age=0,max-age-ms=-1', cc2 => '', age => '', age_ms => '',
      expected => '0 0 0 fallback:companion - - 1' },
    { description => 'oversized',
      mode => 1, cc => 'max-age=0,max-age-ms=99999999999999999', cc2 => '', age => '', age_ms => '',
      expected => '0 0 0 fallback:companion - - 1' },
    { description => 'quoted comma',
      tags => ['9:corner'],
      mode => 1, cc => 'max-age=0,x="a,max-age-ms=200"', cc2 => '', age => '', age_ms => '',
      expected => '0 0 0 coarse - - 1' },
    { description => 'coarse only on trusted path',
      tags => ['9:negative'],
      mode => 2, cc => $pair, cc2 => '', age => '0', age_ms => '',
      expected => '0 0 0 fallback:age 0 - 1' },
    { description => 'inconsistent age',
      mode => 2, cc => $pair, cc2 => '', age => '2', age_ms => '175',
      expected => '0 0 0 fallback:age 2 - 1' },
    { description => 'coarse shared precedence',
      mode => 1, cc => $pair, cc2 => 's-maxage=0', age => '', age_ms => '',
      expected => '0 0 0 fallback:companion - - 1' },
    { description => 'stale window',
      mode => 1, cc => $pair, cc2 => 'stale-while-revalidate=0, stale-while-revalidate-ms=200', age => '', age_ms => '',
      expected => '185 200 0 used 0 15 1' },
    { description => 'private',
      tags => ['9:corner'],
      mode => 1, cc => $pair, cc2 => 'private', age => '', age_ms => '',
      expected => '0 0 0 coarse - - 1' },
    { description => 'error window',
      mode => 1, cc => $pair, cc2 => 'stale-if-error=0, stale-if-error-ms=250', age => '', age_ms => '',
      expected => '185 0 250 used 0 15 1' },
    { description => 'error window alone makes the entry fine',
      mode => 1, cc => 'max-age=1', cc2 => 'stale-if-error=0, stale-if-error-ms=250', age => '', age_ms => '',
      expected => '985 0 250 used 0 15 1' },
    { description => 'zero error window',
      mode => 1, cc => $pair, cc2 => 'stale-if-error=5, stale-if-error-ms=0', age => '', age_ms => '',
      expected => '185 0 0 used 0 15 1' },
    { description => 'invalid error companion uses seconds',
      mode => 1, cc => $pair, cc2 => 'stale-if-error=2, stale-if-error-ms=1.5', age => '', age_ms => '',
      expected => '185 0 2000 used 0 15 1' },
    { description => 'duplicate error companion uses seconds',
      mode => 1, cc => $pair, cc2 => 'stale-if-error=2, stale-if-error-ms=5, stale-if-error-ms=5', age => '', age_ms => '',
      expected => '185 0 2000 used 0 15 1' },
    { description => 'oversized error companion uses seconds',
      mode => 1, cc => $pair, cc2 => 'stale-if-error=2, stale-if-error-ms=9999999999999999', age => '', age_ms => '',
      expected => '185 0 2000 used 0 15 1' },
    { description => 'unpaired error companion ignored',
      mode => 1, cc => $pair, cc2 => 'stale-if-error-ms=250', age => '', age_ms => '',
      expected => '185 0 0 used 0 15 1' },
    { description => 'unpaired error companion alone is coarse',
      mode => 1, cc => 'max-age=1', cc2 => 'stale-if-error-ms=250', age => '', age_ms => '',
      expected => '0 0 0 fallback:companion - - 1' },
    { description => 'must-revalidate forbids error window',
      mode => 1, cc => $pair, cc2 => 'must-revalidate, stale-if-error=0, stale-if-error-ms=250', age => '', age_ms => '',
      expected => '185 0 0 used 0 15 1' },
    { description => 'must-revalidate with only an error pair is coarse',
      mode => 1, cc => 'max-age=1', cc2 => 'must-revalidate, stale-if-error=0, stale-if-error-ms=250', age => '', age_ms => '',
      expected => '0 0 0 fallback:companion - - 1' },
    { description => 'shared lifetime forbids error window',
      mode => 1, cc => 's-maxage=0, s-maxage-ms=200', cc2 => 'stale-if-error=0, stale-if-error-ms=250', age => '', age_ms => '',
      expected => '185 0 0 used 0 15 1' },
    { description => 'both stale windows',
      mode => 1, cc => $pair, cc2 => 'stale-while-revalidate=0, stale-while-revalidate-ms=100, stale-if-error=1, stale-if-error-ms=1500', age => '', age_ms => '',
      expected => '185 100 1500 used 0 15 1' },
    { description => 'companion below base',
      mode => 1, cc => 'max-age=60, max-age-ms=200', cc2 => '', age => '', age_ms => '',
      expected => '185 0 0 used 0 15 1' },
    { description => 'companion above base',
      mode => 1, cc => 'max-age=1, max-age-ms=2000', cc2 => '', age => '', age_ms => '',
      expected => '1985 0 0 used 0 15 1' },
    { description => 'companion equal to base',
      mode => 1, cc => 'max-age=1, max-age-ms=1000', cc2 => '', age => '', age_ms => '',
      expected => '985 0 0 used 0 15 1' },
    { description => 'base zero and companion of a day',
      mode => 1, cc => 'max-age=0, max-age-ms=86400000', cc2 => '', age => '', age_ms => '',
      expected => '86399985 0 0 used 0 15 1' },
    { description => 'fifteen digits',
      mode => 1, cc => 'max-age=0, max-age-ms=999999999999999', cc2 => '', age => '', age_ms => '',
      expected => '999999999999984 0 0 used 0 15 1' },
    { description => 'sixteen digits',
      mode => 1, cc => 'max-age=0, max-age-ms=1000000000000000', cc2 => '', age => '', age_ms => '',
      expected => '0 0 0 fallback:companion - - 1' },
    { description => 'leading zeros',
      mode => 1, cc => 'max-age=0, max-age-ms=0200', cc2 => '', age => '', age_ms => '',
      expected => '185 0 0 used 0 15 1' },
    { description => 'sixteen digits with leading zero',
      mode => 1, cc => 'max-age=0, max-age-ms=0000000000000200', cc2 => '', age => '', age_ms => '',
      expected => '0 0 0 fallback:companion - - 1' },
    { description => 'plus sign',
      mode => 1, cc => 'max-age=0, max-age-ms=+200', cc2 => '', age => '', age_ms => '',
      expected => '0 0 0 fallback:companion - - 1' },
    { description => 'unit suffix',
      mode => 1, cc => 'max-age=0, max-age-ms=200ms', cc2 => '', age => '', age_ms => '',
      expected => '0 0 0 fallback:companion - - 1' },
    { description => 'fraction',
      mode => 1, cc => 'max-age=0, max-age-ms=0.2', cc2 => '', age => '', age_ms => '',
      expected => '0 0 0 fallback:companion - - 1' },
    { description => 'empty argument',
      mode => 1, cc => 'max-age=0, max-age-ms=', cc2 => '', age => '', age_ms => '',
      expected => '0 0 0 fallback:companion - - 1' },
    { description => 'no argument',
      mode => 1, cc => 'max-age=0, max-age-ms', cc2 => '', age => '', age_ms => '',
      expected => '0 0 0 fallback:companion - - 1' },
    { description => 'quoted argument',
      mode => 1, cc => 'max-age=0, max-age-ms="200"', cc2 => '', age => '', age_ms => '',
      expected => '0 0 0 fallback:companion - - 1' },
    { description => 'mixed case names',
      mode => 1, cc => 'Max-Age=0, MAX-AGE-MS=200', cc2 => '', age => '', age_ms => '',
      expected => '185 0 0 used 0 15 1' },
    { description => 'longer directive name',
      mode => 1, cc => 'max-age=0, max-age-msx=200', cc2 => '', age => '', age_ms => '',
      expected => '0 0 0 coarse - - 1' },
    { description => 'prefixed directive name',
      mode => 1, cc => 'max-age=0, x-max-age-ms=200', cc2 => '', age => '', age_ms => '',
      expected => '0 0 0 coarse - - 1' },
    { description => 'shared companion on a private base',
      mode => 1, cc => 'max-age=0, s-maxage-ms=200', cc2 => '', age => '', age_ms => '',
      expected => '0 0 0 fallback:companion - - 1' },
    { description => 'window companion below its base',
      mode => 1, cc => $pair, cc2 => 'stale-while-revalidate=60, stale-while-revalidate-ms=200', age => '', age_ms => '',
      expected => '185 200 0 used 0 15 1' },
    { description => 'age beyond the lifetime',
      mode => 2, cc => $pair, cc2 => '', age => '0', age_ms => '900',
      expected => '-715 0 0 used 0 915 1' },

    # Age and Age-Ms come from one estimate, and Age is its floor.
    { description => 'stored entry at age zero',
      tags => ['3:boundary', '6:positive'],
      mode => 1, cc => $pair, cc2 => '', age => '', age_ms => '',
      env => { FINE_STORED_AGE => '0' },
      expected => '200 0 0 used 0 0 1' },
    { description => 'stored entry one millisecond short of a second',
      tags => ['3:positive'],
      mode => 1, cc => $pair, cc2 => '', age => '', age_ms => '',
      env => { FINE_STORED_AGE => '999' },
      expected => '-799 0 0 used 0 999 1' },
    { description => 'stored entry at exactly one second',
      tags => ['6:positive'],
      mode => 1, cc => $pair, cc2 => '', age => '', age_ms => '',
      env => { FINE_STORED_AGE => '1000' },
      expected => '-800 0 0 used 1 1000 1' },
    { description => 'stored entry one millisecond short of two seconds',
      mode => 1, cc => $pair, cc2 => '', age => '', age_ms => '',
      env => { FINE_STORED_AGE => '1999' },
      expected => '-1799 0 0 used 1 1999 1' },
    { description => 'received pair on a second boundary',
      mode => 2, cc => $pair, cc2 => '', age => '1', age_ms => '1000',
      expected => '-815 0 0 used 1 1015 1' },
    { description => 'received age of zero',
      mode => 2, cc => $pair, cc2 => '', age => '0', age_ms => '0',
      expected => '185 0 0 used 0 15 1' },

    # Age-Ms is sent only when proxy_cache_fine_age_header is on.
    { description => 'new entry with the age header off',
      tags => ['6:negative'],
      mode => 1, cc => $pair, cc2 => '', age => '', age_ms => '',
      env => { FINE_AGE_HEADER => '0' },
      expected => '185 0 0 used 0 - 1' },
    { description => 'stored entry with the age header off',
      tags => ['6:negative'],
      mode => 1, cc => $pair, cc2 => '', age => '', age_ms => '',
      env => { FINE_STORED_AGE => '1175', FINE_AGE_HEADER => '0' },
      expected => '-975 0 0 used 1 - 1' },
    { description => 'received Age-Ms is not forwarded with the header off',
      tags => ['6:negative'],
      mode => 2, cc => $pair, cc2 => '', age => '0', age_ms => '175',
      env => { FINE_AGE_HEADER => '0' },
      expected => '10 0 0 used 0 - 1' },

    # A negative age is a clock fault: no age is reported.
    { description => 'stored entry one millisecond in the future',
      tags => ['3:boundary', '9:boundary'],
      mode => 1, cc => $pair, cc2 => '', age => '', age_ms => '',
      env => { FINE_STORED_AGE => '-1' },
      expected => '201 0 0 clock - - 1' },
    { description => 'stored entry five seconds in the future',
      tags => ['3:negative', '9:negative'],
      mode => 1, cc => $pair, cc2 => '', age => '', age_ms => '',
      env => { FINE_STORED_AGE => '-5000' },
      expected => '5200 0 0 clock - - 1' },

    # Age fields that cannot be used leave the whole-second policy.
    { description => 'Age-Ms without Age',
      mode => 2, cc => $pair, cc2 => '', age => '', age_ms => '175',
      expected => '0 0 0 fallback:age - - 1' },
    { description => 'Age at an origin',
      mode => 1, cc => $pair, cc2 => '', age => '0', age_ms => '',
      expected => '0 0 0 fallback:age 0 - 1' },
    { description => 'Age pair at an origin',
      mode => 1, cc => $pair, cc2 => '', age => '0', age_ms => '175',
      expected => '0 0 0 fallback:age 0 - 1' },
    { description => 'negative Age-Ms',
      mode => 2, cc => $pair, cc2 => '', age => '0', age_ms => '-1',
      expected => '0 0 0 fallback:age 0 - 1' },
    { description => 'fractional Age-Ms',
      mode => 2, cc => $pair, cc2 => '', age => '0', age_ms => '17.5',
      expected => '0 0 0 fallback:age 0 - 1' },
    { description => 'sixteen digit Age-Ms',
      mode => 2, cc => $pair, cc2 => '', age => '1000000000000', age_ms => '1000000000000000',
      expected => '0 0 0 fallback:age 1000000000000 - 1' },
    { description => 'Age one second ahead of Age-Ms',
      mode => 2, cc => $pair, cc2 => '', age => '1', age_ms => '999',
      expected => '0 0 0 fallback:age 1 - 1' },

    # An age of decades falls back and stays cacheable.
    { description => 'largest age that leaves a deadline',
      tags => ['7:boundary', '7:positive'],
      mode => 2, cc => $pair, cc2 => '', age => '100', age_ms => '100184',
      expected => '-99999 0 0 used 100 100199 1' },
    { description => 'smallest age with no deadline',
      tags => ['7:boundary', '9:boundary'],
      mode => 2, cc => $pair, cc2 => '', age => '100', age_ms => '100185',
      expected => '0 0 0 fallback:range 100 - 1' },
    { description => 'fifteen digit age',
      tags => ['7:negative', '9:negative'],
      mode => 2, cc => $pair, cc2 => '', age => '999999999999', age_ms => '999999999999999',
      expected => '0 0 0 fallback:range 999999999999 - 1' },

    # A stored whole-second entry reports the time it has been stored.
    { description => 'whole-second entry adds residence to Age',
      tags => ['8:positive'],
      mode => 1, cc => 'max-age=5', cc2 => '', age => '2', age_ms => '',
      env => { COARSE_STORED_AGE => '3' },
      expected => '0 0 0 coarse 5 - 1' },
    { description => 'whole-second entry without Age',
      tags => ['8:positive'],
      mode => 1, cc => 'max-age=5', cc2 => '', age => '', age_ms => '',
      env => { COARSE_STORED_AGE => '3' },
      expected => '0 0 0 coarse 3 - 1' },
    { description => 'whole-second entry just stored',
      tags => ['8:boundary'],
      mode => 1, cc => 'max-age=5', cc2 => '', age => '2', age_ms => '',
      env => { COARSE_STORED_AGE => '0' },
      expected => '0 0 0 coarse 2 - 1' },
    { description => 'whole-second entry just stored, without Age',
      tags => ['8:boundary'],
      mode => 1, cc => 'max-age=5', cc2 => '', age => '', age_ms => '',
      env => { COARSE_STORED_AGE => '0' },
      expected => '0 0 0 coarse 0 - 1' },
    { description => 'whole-second entry with an invalid Age',
      tags => ['8:negative'],
      mode => 1, cc => 'max-age=5', cc2 => '', age => 'x', age_ms => '',
      env => { COARSE_STORED_AGE => '3' },
      expected => '0 0 0 coarse x - 1' },
    { description => 'whole-second entry stored in the future',
      tags => ['8:corner'],
      mode => 1, cc => 'max-age=5', cc2 => '', age => '2', age_ms => '',
      env => { COARSE_STORED_AGE => '-2' },
      expected => '0 0 0 coarse 2 - 1' },
    { description => 'whole-second entry never forwards Age-Ms',
      tags => ['8:corner', '6:corner'],
      mode => 2, cc => 'max-age=5', cc2 => '', age => '2', age_ms => '2175',
      env => { COARSE_STORED_AGE => '3' },
      expected => '0 0 0 coarse 5 - 1' },
    # The request delay runs from the start of the upstream attempt to the
    # clock reading.  It is not taken from a value stored earlier.
    { description => 'delay counted when the stored header time reads zero',
      tags => ['2:positive'],
      mode => 1, cc => $pair, cc2 => '', age => '', age_ms => '',
      env => { FINE_NOW_MSEC => '1015', FINE_START => '1000',
               FINE_HEADER_TIME => '0' },
      expected => '185 0 0 used 0 15 1' },
    { description => 'delay added to a received age',
      tags => ['2:positive'],
      mode => 2, cc => $pair, cc2 => '', age => '0', age_ms => '175',
      env => { FINE_NOW_MSEC => '1040', FINE_START => '1000' },
      expected => '-15 0 0 used 0 215 1' },
    { description => 'delay of zero',
      tags => ['2:boundary'],
      mode => 1, cc => $pair, cc2 => '', age => '', age_ms => '',
      env => { FINE_NOW_MSEC => '1000', FINE_START => '1000',
               FINE_HEADER_TIME => '7' },
      expected => '200 0 0 used 0 0 1' },
    { description => 'delay of one millisecond',
      tags => ['2:boundary'],
      mode => 1, cc => $pair, cc2 => '', age => '', age_ms => '',
      env => { FINE_NOW_MSEC => '1001', FINE_START => '1000' },
      expected => '199 0 0 used 0 1 1' },
    { description => 'delay of exactly one second',
      tags => ['2:boundary'],
      mode => 1, cc => $pair, cc2 => '', age => '', age_ms => '',
      env => { FINE_NOW_MSEC => '2000', FINE_START => '1000' },
      expected => '-800 0 0 used 1 1000 1' },
    { description => 'a stored header time larger than the delay is not used',
      tags => ['2:negative'],
      mode => 1, cc => $pair, cc2 => '', age => '', age_ms => '',
      env => { FINE_NOW_MSEC => '1015', FINE_START => '1000',
               FINE_HEADER_TIME => '500' },
      expected => '185 0 0 used 0 15 1' },
    { description => 'a stored header time smaller than the delay is not used',
      tags => ['2:negative'],
      mode => 1, cc => $pair, cc2 => '', age => '', age_ms => '',
      env => { FINE_NOW_MSEC => '1150', FINE_START => '1000',
               FINE_HEADER_TIME => '3' },
      expected => '50 0 0 used 0 150 1' },
    { description => 'delay across a wrap of the millisecond counter',
      tags => ['2:corner'],
      mode => 1, cc => $pair, cc2 => '', age => '', age_ms => '',
      env => { FINE_NOW_MSEC => '5', FINE_START => '18446744073709551606' },
      expected => '185 0 0 used 0 15 1' },
    { description => 'start after the reading is a clock fault',
      tags => ['2:corner', '3:corner'],
      mode => 1, cc => $pair, cc2 => '', age => '', age_ms => '',
      env => { FINE_NOW_MSEC => '1000', FINE_START => '1010' },
      expected => '210 0 0 clock - - 1' },

    # More cases for the clock fault, the age header and the range fallback.
    { description => 'future entry with the age header off',
      tags => ['3:corner', '6:corner'],
      mode => 1, cc => $pair, cc2 => '', age => '', age_ms => '',
      env => { FINE_STORED_AGE => '-1', FINE_AGE_HEADER => '0' },
      expected => '201 0 0 clock - - 1' },
    { description => 'stored entry at age zero with the age header off',
      tags => ['6:boundary'],
      mode => 1, cc => $pair, cc2 => '', age => '', age_ms => '',
      env => { FINE_STORED_AGE => '0', FINE_AGE_HEADER => '0' },
      expected => '200 0 0 used 0 - 1' },
    { description => 'stored entry at one second with the age header off',
      tags => ['6:boundary'],
      mode => 1, cc => $pair, cc2 => '', age => '', age_ms => '',
      env => { FINE_STORED_AGE => '1000', FINE_AGE_HEADER => '0' },
      expected => '-800 0 0 used 1 - 1' },
    { description => 'out-of-range age with a stale window pair',
      tags => ['7:corner'],
      mode => 2, cc => $pair,
      cc2 => 'stale-while-revalidate=0, stale-while-revalidate-ms=200',
      age => '100', age_ms => '100185',
      expected => '0 0 0 fallback:range 100 - 1' },
    { description => 'out-of-range age with the age header off',
      tags => ['7:corner'],
      mode => 2, cc => $pair, cc2 => '', age => '100', age_ms => '100185',
      env => { FINE_AGE_HEADER => '0' },
      expected => '0 0 0 fallback:range 100 - 1' },
    { description => 'whole-second entry stored for one second',
      tags => ['8:boundary'],
      mode => 1, cc => 'max-age=5', cc2 => '', age => '2', age_ms => '',
      env => { COARSE_STORED_AGE => '1' },
      expected => '0 0 0 coarse 3 - 1' },
);
for my $case (@cases) {
    local %ENV = (%ENV, %{ $case->{env} // {} });
    open my $pipe, '-|', $binary, @$case{qw(mode cc cc2 age age_ms)}
        or die "Run header test: $!";
    my $result = <$pipe> // '';
    chomp $result;
    close $pipe or die "Header test exited $?";
    is($result, $case->{expected}, $case->{description});
}

my @validation = (
    { description => '304 inherits lifetime', update => '',
      expected => '185 0 0 used 0 15 1' },
    { description => '304 replaces lifetime', update => 'max-age=0, max-age-ms=1250',
      expected => '1235 0 0 used 0 15 1' },
    { description => '304 switches to whole seconds', update => 'max-age=5',
      expected => '0 0 0 coarse - - 1' },
    { description => '304 disables reuse', update => 'no-store',
      expected => '0 0 0 coarse - - 1' },
);
for my $case (@validation) {
    # The stored 200 carried Age: 9 and Age-Ms: 9000, which a 304 replaces.
    open my $pipe, '-|', $binary, 1, $pair, '', '9', '9000', $case->{update}
        or die "Run validation test: $!";
    chomp(my $result = <$pipe>);
    close $pipe or die "Validation test exited $?";
    is($result, $case->{expected}, $case->{description});
}
done_testing();
